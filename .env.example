# Local: copy to .env. No key is needed ONLY for loopback development with username local.
RAG_ENVIRONMENT=development
RAG_USERS_JSON={}
RAG_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Hosted: production + HTTPS + a unique key per user (at least 16 random characters).
# RAG_USERS_JSON={"alice":"REPLACE_WITH_A_RANDOM_PROVISIONED_KEY"}
# RAG_ALLOWED_HOSTS=["docs.example.com","localhost","127.0.0.1"]
RAG_DATA_DIR=runtime/langchain-v2
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_MODEL=gemma2:2b
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RAG_EMBEDDING_DEVICE=cpu
# Explicitly provision models with scripts.prepare_models; runtime loads cached artifacts.
RAG_ALLOW_MODEL_DOWNLOADS=false
RAG_CHUNK_TOKENS=220
RAG_CHUNK_OVERLAP=35
RAG_TOP_K=6
RAG_FETCH_K=18
# This is a retrieval ranking cutoff, NOT confidence. Calibrate on your corpus.
RAG_RELEVANCE_THRESHOLD=0.25
RAG_CONTEXT_TOKENS=8192
RAG_OUTPUT_TOKENS=768
RAG_MODEL_TIMEOUT=90
RAG_MAX_CONCURRENT_CHATS=2
RAG_MAX_UPLOAD_MB=25
RAG_MAX_STORAGE_MB=500
RAG_MAX_DOCUMENTS=100
RAG_RETENTION_DAYS=30
# Optional narrow email/phone policy. Raw payloads are never in default app logs.
RAG_REDACT_PII=false
